{
  "name": "AstroScope AI Observatory",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": {
      "label": "AstroScope AI",
      "onAutoForward": "openPreview"
    }
  },
  "postCreateCommand": "python -m pip install --upgrade pip && python -m pip install -e '.[dev]'",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "yzhang.markdown-all-in-one"
      ]
    }
  }
}
